<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChromaLab.Controls.FilterInspector">
  <Border BorderBrush="{DynamicResource EditorBorderBrush}"
          BorderThickness="1,0,0,0"
          Background="{DynamicResource EditorPanelBrush}">
    <DockPanel Margin="12,10">
      <TextBlock DockPanel.Dock="Top"
                 Text="INSPECTOR"
                 FontSize="10"
                 FontWeight="SemiBold"
                 Opacity="0.55"
                 Margin="0,0,0,8"
                 LetterSpacing="0.6" />

      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
        <Button Name="ApplyButton"
                Content="Apply"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsDefault="True"
                IsEnabled="False" />
        <Button Name="CancelButton"
                Content="Cancel"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsCancel="True"
                IsEnabled="False" />
        <Button Name="ResetParamsButton"
                Content="Reset parameters"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsEnabled="False" />
        <Button Name="RandomizeButton"
                Content="Randomize seed"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsVisible="False"
                IsEnabled="False" />
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <TextBlock Name="TitleText"
                     Text="No filter selected"
                     FontSize="15"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Name="HintText"
                     Text="Pick a filter from the left rail. Parametric effects preview live; Apply commits to undo."
                     FontSize="12"
                     Opacity="0.7"
                     TextWrapping="Wrap" />
          <StackPanel Name="ParamsHost" Spacing="14" IsVisible="False" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
