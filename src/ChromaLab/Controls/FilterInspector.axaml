<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChromaLab.Controls.FilterInspector">
  <Border BorderBrush="{DynamicResource EditorBorderBrush}"
          BorderThickness="1,0,0,0"
          Background="{DynamicResource EditorPanelBrush}">
    <DockPanel Margin="12,10">
      <TextBlock DockPanel.Dock="Top"
                 Text="INSPECTOR"
                 FontSize="10"
                 FontWeight="SemiBold"
                 Opacity="0.55"
                 Margin="0,0,0,8"
                 LetterSpacing="0.6" />

      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,8,*">
          <Button Name="ApplyButton"
                  Grid.Column="0"
                  Content="Apply"
                  Classes="accent"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  IsDefault="True"
                  IsEnabled="False" />
          <Button Name="CancelButton"
                  Grid.Column="2"
                  Content="Cancel"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  IsCancel="True"
                  IsEnabled="False" />
        </Grid>
        <Grid ColumnDefinitions="*,8,*">
          <Button Name="ResetParamsButton"
                  Grid.Column="0"
                  Content="Reset"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  IsEnabled="False" />
          <Button Name="RandomizeButton"
                  Grid.Column="2"
                  Content="Randomize"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  IsVisible="False"
                  IsEnabled="False" />
        </Grid>
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <TextBlock Name="TitleText"
                     Text="No filter selected"
                     FontSize="15"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Name="HintText"
                     Text="Pick a filter from the left rail. Parametric effects preview live; Apply commits to undo."
                     FontSize="12"
                     Opacity="0.7"
                     TextWrapping="Wrap" />
          <TextBlock Name="CenterHintText"
                     Text="Alt-click the canvas to set the center."
                     FontSize="11"
                     Opacity="0.65"
                     TextWrapping="Wrap"
                     IsVisible="False" />
          <StackPanel Name="ParamsHost" Spacing="14" IsVisible="False" />
          <StackPanel Name="VariantsPanel"
                      Spacing="6"
                      IsVisible="False">
            <DockPanel>
              <Button Name="RefreshVariantsButton"
                      DockPanel.Dock="Right"
                      Content="Refresh"
                      Padding="8,2"
                      FontSize="11"
                      IsVisible="False"
                      IsEnabled="False" />
              <TextBlock Text="Variants"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Opacity="0.55"
                         LetterSpacing="0.6"
                         VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <StackPanel Name="VariantsHost"
                          Orientation="Horizontal"
                          Spacing="4" />
            </ScrollViewer>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
