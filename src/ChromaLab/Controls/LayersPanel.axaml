<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lab="using:ChromaLab.Controls"
             x:Class="ChromaLab.Controls.LayersPanel">
  <Border BorderBrush="{DynamicResource EditorBorderBrush}"
          BorderThickness="1,1,0,0"
          Background="{DynamicResource EditorPanelBrush}">
    <DockPanel Margin="10,8">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBlock Text="LAYERS"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Opacity="0.55"
                   LetterSpacing="0.6"
                   VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="2">
          <Button Name="AddButton" Classes="tool" ToolTip.Tip="Add layer" Width="28" Height="26" Padding="4">
            <lab:LabIcon Kind="square-plus" Size="14" Foreground="{DynamicResource IconMutedBrush}" />
          </Button>
          <Button Name="DupButton" Classes="tool" ToolTip.Tip="Duplicate layer" Width="28" Height="26" Padding="4">
            <lab:LabIcon Kind="copy" Size="14" Foreground="{DynamicResource IconMutedBrush}" />
          </Button>
          <Button Name="DeleteButton" Classes="tool" ToolTip.Tip="Delete layer" Width="28" Height="26" Padding="4">
            <lab:LabIcon Kind="trash" Size="14" Foreground="{DynamicResource IconDangerBrush}" />
          </Button>
          <Button Name="UpButton" Classes="tool" ToolTip.Tip="Move up" Width="28" Height="26" Padding="4">
            <lab:LabIcon Kind="chevron-up" Size="14" Foreground="{DynamicResource IconMutedBrush}" />
          </Button>
          <Button Name="DownButton" Classes="tool" ToolTip.Tip="Move down" Width="28" Height="26" Padding="4">
            <lab:LabIcon Kind="chevron-down" Size="14" Foreground="{DynamicResource IconMutedBrush}" />
          </Button>
        </StackPanel>
      </DockPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Name="LayersHost" Spacing="2" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
