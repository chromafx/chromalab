<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ChromaLab.Dialogs.CanvasSizeDialog"
        Title="Canvas Size"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource EditorPanelBrush}">
  <DockPanel Margin="16" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,20,0,0">
      <Button Name="OkButton" Content="OK" MinWidth="88" IsDefault="True" />
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Text="Change the document canvas size. Layer pixels stay as-is; content outside the new canvas is clipped on display."
                 TextWrapping="Wrap"
                 FontSize="12"
                 Opacity="0.8" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Width" VerticalAlignment="Center" />
        <NumericUpDown Name="WidthBox"
                       Grid.Row="0" Grid.Column="1"
                       Minimum="1"
                       Maximum="16384"
                       Increment="1"
                       FormatString="0"
                       HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Height" VerticalAlignment="Center" />
        <NumericUpDown Name="HeightBox"
                       Grid.Row="1" Grid.Column="1"
                       Minimum="1"
                       Maximum="16384"
                       Increment="1"
                       FormatString="0"
                       HorizontalAlignment="Stretch" />
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
