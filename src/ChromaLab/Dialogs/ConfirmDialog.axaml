<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ChromaLab.Dialogs.ConfirmDialog"
        Title="ChromaLab"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource EditorPanelBrush}">
  <DockPanel Margin="16" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,20,0,0">
      <Button Name="SaveButton" Content="Save…" MinWidth="88" IsDefault="True" />
      <Button Name="DiscardButton" Content="Don't Save" MinWidth="88" />
      <Button Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
    </StackPanel>
    <TextBlock Name="MessageText"
               TextWrapping="Wrap"
               FontSize="13" />
  </DockPanel>
</Window>
