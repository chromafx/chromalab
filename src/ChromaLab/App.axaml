<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChromaLab.App"
             Name="ChromaLab"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="EditorPanelBrush">#FF1A1D23</SolidColorBrush>
    <SolidColorBrush x:Key="EditorCanvasBrush">#FF12141A</SolidColorBrush>
    <SolidColorBrush x:Key="EditorBorderBrush">#FF2A2F3A</SolidColorBrush>
    <SolidColorBrush x:Key="EditorAccentBrush">#FF3D8FD1</SolidColorBrush>
    <SolidColorBrush x:Key="EditorAccentMutedBrush">#403D8FD1</SolidColorBrush>
    <SolidColorBrush x:Key="EditorToolSelectedBrush">#FF243447</SolidColorBrush>
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" DestinationRect="0,0,16,16" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FF2A2E36" Geometry="M0,0 H16 V16 H0 Z" />
          <GeometryDrawing Brush="#FF1E2229" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EditorToolSelectedBrush}" />
    </Style>
    <Style Selector="Button.tool.selected">
      <Setter Property="Background" Value="{DynamicResource EditorToolSelectedBrush}" />
    </Style>
    <Style Selector="Button.tool:disabled Path">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Separator.tool-sep">
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail-tab">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.rail-tab.selected">
      <Setter Property="Background" Value="{DynamicResource EditorToolSelectedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.catalog-entry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.catalog-entry:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EditorToolSelectedBrush}" />
    </Style>
  </Application.Styles>
</Application>
