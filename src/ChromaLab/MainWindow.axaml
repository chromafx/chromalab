<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:ChromaLab.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="ChromaLab.MainWindow"
        Title="ChromaLab"
        Width="1280" Height="720"
        MinWidth="880" MinHeight="480">
  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="Margin" Value="1,0" />
    </Style>
    <Style Selector="Button.tool:disabled Path">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Separator.tool-sep">
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Name="OpenMenuItem" Header="_Open…" />
        <MenuItem Name="SaveMenuItem" Header="_Save" IsEnabled="False" />
        <MenuItem Name="SaveAsMenuItem" Header="Save _As…" IsEnabled="False" />
        <MenuItem Name="ExportMenuItem" Header="_Export…" IsEnabled="False" />
        <Separator />
        <MenuItem Name="ExitMenuItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Name="UndoMenuItem" Header="_Undo" IsEnabled="False" />
        <MenuItem Name="RedoMenuItem" Header="_Redo" IsEnabled="False" />
        <Separator />
        <MenuItem Name="ResetMenuItem" Header="_Reset to Original" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Name="ZoomInMenuItem" Header="Zoom _In" IsEnabled="False" />
        <MenuItem Name="ZoomOutMenuItem" Header="Zoom _Out" IsEnabled="False" />
        <Separator />
        <MenuItem Name="ActualSizeMenuItem" Header="_Actual Size (100%)" IsEnabled="False" />
        <MenuItem Name="FitMenuItem" Header="_Fit to Window" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Layers">
        <MenuItem Name="LayerAddMenuItem" Header="_Add Layer" IsEnabled="False" />
        <MenuItem Name="LayerDuplicateMenuItem" Header="_Duplicate Layer" IsEnabled="False" />
        <MenuItem Name="LayerDeleteMenuItem" Header="De_lete Layer" IsEnabled="False" />
        <Separator />
        <MenuItem Name="LayerPrevMenuItem" Header="Select _Previous" IsEnabled="False" />
        <MenuItem Name="LayerNextMenuItem" Header="Select _Next" IsEnabled="False" />
        <MenuItem Name="LayerToggleVisibleMenuItem" Header="Toggle _Visibility" IsEnabled="False" />
      </MenuItem>
      <MenuItem Name="FiltersMenu" Header="F_ilters" />
    </Menu>

    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="6,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="0">
        <Button Name="OpenButton" Classes="tool" ToolTip.Tip="Open (Ctrl+O)">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M2,3 H8 L10,5 H18 V17 H2 Z M2,3 V17" />
        </Button>
        <Button Name="SaveButton" Classes="tool" ToolTip.Tip="Save (Ctrl+S)" IsEnabled="False">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M3,2 H13 L17,6 V18 H3 Z M6,2 V8 H12 V2 M6,12 H14 V18 H6 Z" />
        </Button>
        <Button Name="ExportButton" Classes="tool" ToolTip.Tip="Export… (Ctrl+E)" IsEnabled="False">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M8,2 V11 M5,8 L8,11 L11,8 M3,13 H13 V16 H3 Z" />
        </Button>

        <Separator Classes="tool-sep" />

        <Button Name="UndoButton" Classes="tool" ToolTip.Tip="Undo (Ctrl+Z)" IsEnabled="False">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M7,3 L2,8 L7,13 M2,8 H12 A4,4 0 0 1 12,16 H8" />
        </Button>
        <Button Name="RedoButton" Classes="tool" ToolTip.Tip="Redo (Ctrl+Y)" IsEnabled="False">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M9,3 L14,8 L9,13 M14,8 H4 A4,4 0 0 0 4,16 H8" />
        </Button>
        <Button Name="ResetButton" Classes="tool" ToolTip.Tip="Reset to original" IsEnabled="False">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M3,8 A5,5 0 1 1 8,13 M3,8 L5,5 M3,8 L5,11" />
        </Button>

        <Separator Classes="tool-sep" />

        <Button Name="ZoomOutButton" Classes="tool" ToolTip.Tip="Zoom out (Ctrl+-)" IsEnabled="False">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M2,8 H14 M12,4 A5,5 0 1 0 12,12" />
        </Button>
        <Button Name="ZoomInButton" Classes="tool" ToolTip.Tip="Zoom in (Ctrl+=)" IsEnabled="False">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M2,8 H10 M6,4 V12 M12,4 A5,5 0 1 0 12,12" />
        </Button>
        <Button Name="ActualSizeButton" Classes="tool" ToolTip.Tip="Actual size 100% (Ctrl+0)" IsEnabled="False">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M2,2 H6 V6 H2 Z M10,10 H14 V14 H10 Z M7,7 H9 V9 H7 Z" />
        </Button>
        <Button Name="FitButton" Classes="tool" ToolTip.Tip="Fit to window (Ctrl+1)" IsEnabled="False">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Data="M2,2 H6 V4 H4 V6 H2 Z M10,2 H14 V6 H12 V4 H10 Z M2,10 H4 V12 H6 V14 H2 Z M12,10 H14 V14 H10 V12 H12 Z" />
        </Button>

        <Separator Name="FavoriteToolsSep" Classes="tool-sep" IsVisible="False" />
        <StackPanel Name="FavoriteTools" Orientation="Horizontal" Spacing="0" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,5"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <TextBlock Name="ZoomText"
                   DockPanel.Dock="Right"
                   Text="—"
                   FontSize="12"
                   Opacity="0.9"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Name="MetaText"
                   DockPanel.Dock="Right"
                   Text=""
                   FontSize="12"
                   Opacity="0.75"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Name="StatusText"
                   Text="Ready"
                   FontSize="12"
                   Opacity="0.9"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <controls:FilterInspector Name="Inspector"
                              DockPanel.Dock="Right"
                              Width="280"
                              MinWidth="240"
                              MaxWidth="360" />

    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <ScrollViewer Name="PreviewScroll"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    AllowAutoHide="False"
                    Focusable="True">
        <!-- Sized to at least the viewport so a smaller image can Center. -->
        <Panel Name="PreviewContentHost">
          <Border Name="EmptyHint"
                  IsVisible="True"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="24"
                  Opacity="0.55">
            <StackPanel Spacing="6">
              <TextBlock Text="File → Open… or drop an image here"
                         FontSize="14"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Scroll to zoom · drag to pan"
                         FontSize="12"
                         Opacity="0.8"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <LayoutTransformControl Name="ZoomHost"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="False">
            <Border Name="PreviewFrame"
                    Background="#202020"
                    Cursor="SizeAll">
              <Image Name="PreviewImage" Stretch="None" />
            </Border>
          </LayoutTransformControl>
        </Panel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
