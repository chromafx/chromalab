<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:ChromaLab.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="ChromaLab.MainWindow"
        Title="ChromaLab"
        Icon="/Assets/icon.ico"
        Width="1280" Height="720"
        MinWidth="960" MinHeight="560"
        Background="{DynamicResource EditorCanvasBrush}">

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Name="OpenMenuItem" Header="_Open…" />
        <MenuItem Name="SaveMenuItem" Header="_Save" IsEnabled="False" />
        <MenuItem Name="SaveAsMenuItem" Header="Save _As…" IsEnabled="False" />
        <MenuItem Name="ExportMenuItem" Header="_Export…" IsEnabled="False" />
        <Separator />
        <MenuItem Name="ExitMenuItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Name="UndoMenuItem" Header="_Undo" IsEnabled="False" />
        <MenuItem Name="RedoMenuItem" Header="_Redo" IsEnabled="False" />
        <Separator />
        <MenuItem Name="CanvasSizeMenuItem" Header="_Canvas Size…" IsEnabled="False" />
        <Separator />
        <MenuItem Name="ResetMenuItem" Header="_Reset to Original" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Name="ZoomInMenuItem" Header="Zoom _In" IsEnabled="False" />
        <MenuItem Name="ZoomOutMenuItem" Header="Zoom _Out" IsEnabled="False" />
        <Separator />
        <MenuItem Name="ActualSizeMenuItem" Header="_Actual Size (100%)" IsEnabled="False" />
        <MenuItem Name="FitMenuItem" Header="_Fit to Window" IsEnabled="False" />
        <Separator />
        <MenuItem Name="CompareMenuItem" Header="Hold to _Compare" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Layers">
        <MenuItem Name="LayerAddMenuItem" Header="_Add Layer" IsEnabled="False" />
        <MenuItem Name="LayerDuplicateMenuItem" Header="_Duplicate Layer" IsEnabled="False" />
        <MenuItem Name="LayerDeleteMenuItem" Header="De_lete Layer" IsEnabled="False" />
        <Separator />
        <MenuItem Name="LayerPrevMenuItem" Header="Select _Previous" IsEnabled="False" />
        <MenuItem Name="LayerNextMenuItem" Header="Select _Next" IsEnabled="False" />
        <MenuItem Name="LayerToggleVisibleMenuItem" Header="Toggle _Visibility" IsEnabled="False" />
        <Separator />
        <MenuItem Name="LayerMoveUpMenuItem" Header="Move _Up" IsEnabled="False" />
        <MenuItem Name="LayerMoveDownMenuItem" Header="Move _Down" IsEnabled="False" />
      </MenuItem>
      <MenuItem Name="FiltersMenu" Header="F_ilters" />
      <MenuItem Header="_Macros">
        <MenuItem Name="MacroRecordMenuItem" Header="Start _Recording" />
        <MenuItem Name="MacroSaveMenuItem" Header="_Save Macro…" IsEnabled="False" />
        <Separator />
        <MenuItem Name="MacroRunMenuItem" Header="Open &amp; _Run…" IsEnabled="False" />
        <MenuItem Name="MacroBulkMenuItem" Header="_Bulk Process…" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource EditorBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4"
            Background="{DynamicResource EditorPanelBrush}">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="/Assets/icon.png" Width="22" Height="22" Stretch="Uniform" />
          <TextBlock Text="ChromaLab"
                     FontSize="13"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Opacity="0.9" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="0"
                    VerticalAlignment="Center">
          <Button Name="OpenButton" Classes="tool">
            <controls:LabIcon Kind="folder-open" Size="16" Foreground="{DynamicResource IconMutedBrush}" />
          </Button>
          <Button Name="SaveButton" Classes="tool" IsEnabled="False">
            <controls:LabIcon Kind="save" Size="16" Foreground="{DynamicResource IconAccentGradient}" />
          </Button>
          <Button Name="ExportButton" Classes="tool" IsEnabled="False">
            <controls:LabIcon Kind="upload" Size="16" Foreground="{DynamicResource IconSuccessGradient}" />
          </Button>

          <Separator Classes="tool-sep" />

          <Button Name="UndoButton" Classes="tool" IsEnabled="False">
            <controls:LabIcon Kind="undo-2" Size="16" Foreground="{DynamicResource IconAccentBrush}" />
          </Button>
          <Button Name="RedoButton" Classes="tool" IsEnabled="False">
            <controls:LabIcon Kind="redo-2" Size="16" Foreground="{DynamicResource IconAccentBrush}" />
          </Button>
          <Button Name="ResetButton" Classes="tool" IsEnabled="False">
            <controls:LabIcon Kind="rotate-ccw" Size="16" Foreground="{DynamicResource IconMutedBrush}" />
          </Button>

          <Separator Classes="tool-sep" />

          <Button Name="ZoomOutButton" Classes="tool" IsEnabled="False">
            <controls:LabIcon Kind="zoom-out" Size="16" Foreground="{DynamicResource IconMutedBrush}" />
          </Button>
          <Button Name="ZoomInButton" Classes="tool" IsEnabled="False">
            <controls:LabIcon Kind="zoom-in" Size="16" Foreground="{DynamicResource IconMutedBrush}" />
          </Button>
          <Button Name="ActualSizeButton" Classes="tool" IsEnabled="False">
            <TextBlock Text="1:1"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource IconMutedBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
          </Button>
          <Button Name="FitButton" Classes="tool" IsEnabled="False">
            <controls:LabIcon Kind="maximize-2" Size="16" Foreground="{DynamicResource IconMutedBrush}" />
          </Button>
          <Button Name="CompareButton" Classes="tool" IsEnabled="False">
            <controls:LabIcon Kind="columns-2" Size="16" Foreground="{DynamicResource IconAccentGradient}" />
          </Button>

          <Separator Name="FavoriteToolsSep" Classes="tool-sep" IsVisible="False" />
          <StackPanel Name="FavoriteTools" Orientation="Horizontal" Spacing="0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource EditorBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,5"
            Background="{DynamicResource EditorPanelBrush}">
      <DockPanel>
        <TextBlock Name="ZoomText"
                   DockPanel.Dock="Right"
                   Text="—"
                   FontSize="12"
                   Opacity="0.9"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Name="MetaText"
                   DockPanel.Dock="Right"
                   Text=""
                   FontSize="12"
                   Opacity="0.75"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Border Name="RecordingBadge"
                DockPanel.Dock="Right"
                Background="{DynamicResource EditorAccentMutedBrush}"
                CornerRadius="3"
                Padding="6,2"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                IsVisible="False">
          <TextBlock Text="REC"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource EditorAccentBrush}"
                     VerticalAlignment="Center" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressBar Name="BusyProgress"
                       Width="72"
                       Height="4"
                       IsIndeterminate="True"
                       IsVisible="False"
                       VerticalAlignment="Center" />
          <TextBlock Name="StatusText"
                     Text="Ready"
                     FontSize="12"
                     Opacity="0.9"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Right: inspector + layers -->
    <Grid DockPanel.Dock="Right" Width="300" MinWidth="260" MaxWidth="380">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="160" />
        <RowDefinition Height="4" />
        <RowDefinition Height="*" MinHeight="160" />
      </Grid.RowDefinitions>
      <controls:FilterInspector Name="Inspector" Grid.Row="0" />
      <GridSplitter Grid.Row="1"
                    ResizeDirection="Rows"
                    Background="{DynamicResource EditorBorderBrush}" />
      <controls:LayersPanel Name="LayersPane" Grid.Row="2" />
    </Grid>

    <!-- Left: tools / filter browser -->
    <Border DockPanel.Dock="Left"
            Width="220"
            MinWidth="180"
            MaxWidth="280"
            BorderBrush="{DynamicResource EditorBorderBrush}"
            BorderThickness="0,0,1,0"
            Background="{DynamicResource EditorPanelBrush}"
            Padding="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,8">
          <Button Name="ToolsTabButton" Grid.Column="0" Classes="rail-tab selected" Content="Tools" />
          <Button Name="FiltersTabButton" Grid.Column="1" Classes="rail-tab" Content="Filters" />
        </Grid>

        <StackPanel Name="ToolsPane" Spacing="4">
          <Button Name="HandToolButton" Classes="catalog-entry selected" Content="Hand / Pan" HorizontalContentAlignment="Left" Padding="8,6" />
          <Button Name="CropToolButton" Classes="catalog-entry" Content="Crop (active layer)" HorizontalContentAlignment="Left" Padding="8,6" />
          <Separator Margin="0,6" />
          <TextBlock Text="TRANSFORM"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Opacity="0.55"
                     LetterSpacing="0.6"
                     Margin="4,0,4,2" />
          <Button Name="Rotate90Button" Classes="catalog-entry" Content="Rotate 90° CW" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <Button Name="Rotate180Button" Classes="catalog-entry" Content="Rotate 180°" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <Button Name="FlipHButton" Classes="catalog-entry" Content="Flip horizontal" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <Button Name="FlipVButton" Classes="catalog-entry" Content="Flip vertical" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <Button Name="ResizeToolButton" Classes="catalog-entry" Content="Resize…" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <Button Name="RotateToolButton" Classes="catalog-entry" Content="Rotate…" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <Button Name="SkewToolButton" Classes="catalog-entry" Content="Skew…" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <StackPanel Name="AnimationPane" Spacing="4" Margin="0,10,0,0" IsVisible="False">
            <Separator Margin="0,0,0,4" />
            <TextBlock Text="ANIMATION"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Opacity="0.55"
                       LetterSpacing="0.6"
                       Margin="4,0,4,2" />
            <Button Name="PlayPauseButton" Classes="catalog-entry" Content="Play" HorizontalContentAlignment="Left" Padding="8,6" />
            <TextBlock Name="AnimationFrameText"
                       Text=""
                       FontSize="11"
                       Opacity="0.65"
                       Margin="4,2,4,0" />
          </StackPanel>
          <TextBlock Name="CropHint"
                     Text="Drag a rectangle on the canvas, then Apply Crop below — or press Enter."
                     FontSize="11"
                     Opacity="0.65"
                     TextWrapping="Wrap"
                     Margin="4,10,4,0"
                     IsVisible="False" />
          <StackPanel Name="CropActions" Spacing="6" Margin="0,10,0,0" IsVisible="False">
            <Button Name="ApplyCropButton" Content="Apply Crop" Classes="accent" HorizontalAlignment="Stretch" IsEnabled="False" />
            <Button Name="CancelCropButton" Content="Cancel Crop" HorizontalAlignment="Stretch" IsEnabled="False" />
          </StackPanel>
        </StackPanel>

        <controls:FilterCatalogView Name="FilterBrowser" IsVisible="False" />
      </DockPanel>
    </Border>

    <!-- Center canvas -->
    <Border Background="{DynamicResource EditorCanvasBrush}">
      <ScrollViewer Name="PreviewScroll"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    AllowAutoHide="False"
                    Focusable="True">
        <Panel Name="PreviewContentHost">
          <Border Name="EmptyHint"
                  IsVisible="True"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="28"
                  Opacity="0.7">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
              <Image Source="/Assets/icon.png" Width="64" Height="64" Stretch="Uniform"
                     HorizontalAlignment="Center" Opacity="0.85" />
              <TextBlock Text="ChromaLab"
                         FontSize="22"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Open an image or drop one here"
                         FontSize="14"
                         Opacity="0.8"
                         HorizontalAlignment="Center" />
              <TextBlock Text="PNG, JPEG, WebP, GIF, TIFF, BMP, TGA, OpenRaster"
                         FontSize="11"
                         Opacity="0.5"
                         HorizontalAlignment="Center" />
              <Button Name="EmptyOpenButton"
                      Content="Open…"
                      HorizontalAlignment="Center"
                      Padding="16,8"
                      Margin="0,4,0,0" />
              <TextBlock Text="Scroll to zoom · drag to pan · hold Space to compare"
                         FontSize="11"
                         Opacity="0.55"
                         HorizontalAlignment="Center"
                         Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <LayoutTransformControl Name="ZoomHost"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="False">
            <Border BorderBrush="{DynamicResource EditorBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource EditorCanvasBrush}">
              <Panel>
                <!-- Checkerboard under alpha -->
                <Border Name="Checkerboard"
                        Background="{DynamicResource CheckerBrush}" />
                <Border Name="PreviewFrame" Cursor="SizeAll">
                  <Panel>
                    <Image Name="PreviewImage" Stretch="None" />
                    <Canvas Name="CropOverlay" IsHitTestVisible="False" IsVisible="False">
                      <Rectangle Name="CropShadeTop" Fill="#99000000" IsVisible="False" />
                      <Rectangle Name="CropShadeBottom" Fill="#99000000" IsVisible="False" />
                      <Rectangle Name="CropShadeLeft" Fill="#99000000" IsVisible="False" />
                      <Rectangle Name="CropShadeRight" Fill="#99000000" IsVisible="False" />
                      <Rectangle Name="CropRect"
                                 Stroke="{DynamicResource EditorAccentBrush}"
                                 StrokeThickness="1.5"
                                 Fill="Transparent"
                                 IsVisible="False" />
                    </Canvas>
                  </Panel>
                </Border>
              </Panel>
            </Border>
          </LayoutTransformControl>
        </Panel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
