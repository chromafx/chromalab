<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:ChromaLab.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="ChromaLab.MainWindow"
        Title="ChromaLab"
        Icon="/Assets/icon.ico"
        Width="1280" Height="720"
        MinWidth="960" MinHeight="560"
        Background="{DynamicResource EditorCanvasBrush}">

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Name="OpenMenuItem" Header="_Open…" />
        <MenuItem Name="SaveMenuItem" Header="_Save" IsEnabled="False" />
        <MenuItem Name="SaveAsMenuItem" Header="Save _As…" IsEnabled="False" />
        <MenuItem Name="ExportMenuItem" Header="_Export…" IsEnabled="False" />
        <Separator />
        <MenuItem Name="ExitMenuItem" Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Name="UndoMenuItem" Header="_Undo" IsEnabled="False" />
        <MenuItem Name="RedoMenuItem" Header="_Redo" IsEnabled="False" />
        <Separator />
        <MenuItem Name="ResetMenuItem" Header="_Reset to Original" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Name="ZoomInMenuItem" Header="Zoom _In" IsEnabled="False" />
        <MenuItem Name="ZoomOutMenuItem" Header="Zoom _Out" IsEnabled="False" />
        <Separator />
        <MenuItem Name="ActualSizeMenuItem" Header="_Actual Size (100%)" IsEnabled="False" />
        <MenuItem Name="FitMenuItem" Header="_Fit to Window" IsEnabled="False" />
        <Separator />
        <MenuItem Name="CompareMenuItem" Header="Hold to _Compare" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Layers">
        <MenuItem Name="LayerAddMenuItem" Header="_Add Layer" IsEnabled="False" />
        <MenuItem Name="LayerDuplicateMenuItem" Header="_Duplicate Layer" IsEnabled="False" />
        <MenuItem Name="LayerDeleteMenuItem" Header="De_lete Layer" IsEnabled="False" />
        <Separator />
        <MenuItem Name="LayerPrevMenuItem" Header="Select _Previous" IsEnabled="False" />
        <MenuItem Name="LayerNextMenuItem" Header="Select _Next" IsEnabled="False" />
        <MenuItem Name="LayerToggleVisibleMenuItem" Header="Toggle _Visibility" IsEnabled="False" />
        <Separator />
        <MenuItem Name="LayerMoveUpMenuItem" Header="Move _Up" IsEnabled="False" />
        <MenuItem Name="LayerMoveDownMenuItem" Header="Move _Down" IsEnabled="False" />
      </MenuItem>
      <MenuItem Name="FiltersMenu" Header="F_ilters" />
    </Menu>

    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource EditorBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4"
            Background="{DynamicResource EditorPanelBrush}">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="/Assets/icon.png" Width="22" Height="22" Stretch="Uniform" />
          <TextBlock Text="ChromaLab"
                     FontSize="13"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Opacity="0.9" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="0"
                    VerticalAlignment="Center">
          <Button Name="OpenButton" Classes="tool" ToolTip.Tip="Open (Ctrl+O)">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M2,3 H8 L10,5 H18 V17 H2 Z M2,3 V17" />
          </Button>
          <Button Name="SaveButton" Classes="tool" ToolTip.Tip="Save (Ctrl+S)" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M3,2 H13 L17,6 V18 H3 Z M6,2 V8 H12 V2 M6,12 H14 V18 H6 Z" />
          </Button>
          <Button Name="ExportButton" Classes="tool" ToolTip.Tip="Export… (Ctrl+E)" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M8,2 V11 M5,8 L8,11 L11,8 M3,13 H13 V16 H3 Z" />
          </Button>

          <Separator Classes="tool-sep" />

          <Button Name="UndoButton" Classes="tool" ToolTip.Tip="Undo (Ctrl+Z)" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M7,3 L2,8 L7,13 M2,8 H12 A4,4 0 0 1 12,16 H8" />
          </Button>
          <Button Name="RedoButton" Classes="tool" ToolTip.Tip="Redo (Ctrl+Y)" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M9,3 L14,8 L9,13 M14,8 H4 A4,4 0 0 0 4,16 H8" />
          </Button>
          <Button Name="ResetButton" Classes="tool" ToolTip.Tip="Reset to original" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M3,8 A5,5 0 1 1 8,13 M3,8 L5,5 M3,8 L5,11" />
          </Button>

          <Separator Classes="tool-sep" />

          <Button Name="ZoomOutButton" Classes="tool" ToolTip.Tip="Zoom out (Ctrl+-)" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M2,8 H14 M12,4 A5,5 0 1 0 12,12" />
          </Button>
          <Button Name="ZoomInButton" Classes="tool" ToolTip.Tip="Zoom in (Ctrl+=)" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M2,8 H10 M6,4 V12 M12,4 A5,5 0 1 0 12,12" />
          </Button>
          <Button Name="ActualSizeButton" Classes="tool" ToolTip.Tip="Actual size 100% (Ctrl+0)" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M2,2 H6 V6 H2 Z M10,10 H14 V14 H10 Z M7,7 H9 V9 H7 Z" />
          </Button>
          <Button Name="FitButton" Classes="tool" ToolTip.Tip="Fit to window (Ctrl+1)" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M2,2 H6 V4 H4 V6 H2 Z M10,2 H14 V6 H12 V4 H10 Z M2,10 H4 V12 H6 V14 H2 Z M12,10 H14 V14 H10 V12 H12 Z" />
          </Button>
          <Button Name="CompareButton" Classes="tool" ToolTip.Tip="Hold to compare with original (Space)" IsEnabled="False">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  Data="M2,3 H7 V13 H2 Z M9,3 H14 V13 H9 Z M7,8 H9" />
          </Button>

          <Separator Name="FavoriteToolsSep" Classes="tool-sep" IsVisible="False" />
          <StackPanel Name="FavoriteTools" Orientation="Horizontal" Spacing="0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource EditorBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,5"
            Background="{DynamicResource EditorPanelBrush}">
      <DockPanel>
        <TextBlock Name="ZoomText"
                   DockPanel.Dock="Right"
                   Text="—"
                   FontSize="12"
                   Opacity="0.9"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Name="MetaText"
                   DockPanel.Dock="Right"
                   Text=""
                   FontSize="12"
                   Opacity="0.75"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Name="StatusText"
                   Text="Ready"
                   FontSize="12"
                   Opacity="0.9"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Right: inspector + layers -->
    <Grid DockPanel.Dock="Right" Width="300" MinWidth="260" MaxWidth="380">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="160" />
        <RowDefinition Height="4" />
        <RowDefinition Height="*" MinHeight="160" />
      </Grid.RowDefinitions>
      <controls:FilterInspector Name="Inspector" Grid.Row="0" />
      <GridSplitter Grid.Row="1"
                    ResizeDirection="Rows"
                    Background="{DynamicResource EditorBorderBrush}" />
      <controls:LayersPanel Name="LayersPane" Grid.Row="2" />
    </Grid>

    <!-- Left: tools / filter browser -->
    <Border DockPanel.Dock="Left"
            Width="220"
            MinWidth="180"
            MaxWidth="280"
            BorderBrush="{DynamicResource EditorBorderBrush}"
            BorderThickness="0,0,1,0"
            Background="{DynamicResource EditorPanelBrush}"
            Padding="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,8">
          <Button Name="ToolsTabButton" Grid.Column="0" Classes="rail-tab selected" Content="Tools" />
          <Button Name="FiltersTabButton" Grid.Column="1" Classes="rail-tab" Content="Filters" />
        </Grid>

        <StackPanel Name="ToolsPane" Spacing="4">
          <Button Name="HandToolButton" Classes="catalog-entry selected" Content="Hand / Pan" HorizontalContentAlignment="Left" Padding="8,6" />
          <Button Name="CropToolButton" Classes="catalog-entry" Content="Crop (active layer)" HorizontalContentAlignment="Left" Padding="8,6" />
          <Separator Margin="0,6" />
          <TextBlock Text="TRANSFORM"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Opacity="0.55"
                     LetterSpacing="0.6"
                     Margin="4,0,4,2" />
          <Button Name="Rotate90Button" Classes="catalog-entry" Content="Rotate 90° CW" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <Button Name="Rotate180Button" Classes="catalog-entry" Content="Rotate 180°" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <Button Name="FlipHButton" Classes="catalog-entry" Content="Flip horizontal" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <Button Name="FlipVButton" Classes="catalog-entry" Content="Flip vertical" HorizontalContentAlignment="Left" Padding="8,6" IsEnabled="False" />
          <TextBlock Name="CropHint"
                     Text="Drag a rectangle on the canvas, then Apply Crop in the inspector area — or press Enter."
                     FontSize="11"
                     Opacity="0.65"
                     TextWrapping="Wrap"
                     Margin="4,10,4,0"
                     IsVisible="False" />
          <StackPanel Name="CropActions" Spacing="6" Margin="0,10,0,0" IsVisible="False">
            <Button Name="ApplyCropButton" Content="Apply Crop" HorizontalAlignment="Stretch" IsEnabled="False" />
            <Button Name="CancelCropButton" Content="Cancel Crop" HorizontalAlignment="Stretch" IsEnabled="False" />
          </StackPanel>
        </StackPanel>

        <controls:FilterCatalogView Name="FilterBrowser" IsVisible="False" />
      </DockPanel>
    </Border>

    <!-- Center canvas -->
    <Border Background="{DynamicResource EditorCanvasBrush}">
      <ScrollViewer Name="PreviewScroll"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    AllowAutoHide="False"
                    Focusable="True">
        <Panel Name="PreviewContentHost">
          <Border Name="EmptyHint"
                  IsVisible="True"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="28"
                  Opacity="0.7">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
              <Image Source="/Assets/icon.png" Width="64" Height="64" Stretch="Uniform"
                     HorizontalAlignment="Center" Opacity="0.85" />
              <TextBlock Text="ChromaLab"
                         FontSize="22"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Open an image or drop one here"
                         FontSize="14"
                         Opacity="0.8"
                         HorizontalAlignment="Center" />
              <Button Name="EmptyOpenButton"
                      Content="Open…"
                      HorizontalAlignment="Center"
                      Padding="16,8"
                      Margin="0,4,0,0" />
              <TextBlock Text="Scroll to zoom · drag to pan · hold Space to compare"
                         FontSize="11"
                         Opacity="0.55"
                         HorizontalAlignment="Center"
                         Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <LayoutTransformControl Name="ZoomHost"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="False">
            <Panel>
              <!-- Checkerboard under alpha -->
              <Border Name="Checkerboard"
                      Background="{DynamicResource CheckerBrush}" />
              <Border Name="PreviewFrame" Cursor="SizeAll">
                <Panel>
                  <Image Name="PreviewImage" Stretch="None" />
                  <Canvas Name="CropOverlay" IsHitTestVisible="False" IsVisible="False">
                    <Rectangle Name="CropRect"
                               Stroke="{DynamicResource EditorAccentBrush}"
                               StrokeThickness="1.5"
                               Fill="#403D8FD1"
                               IsVisible="False" />
                  </Canvas>
                </Panel>
              </Border>
            </Panel>
          </LayoutTransformControl>
        </Panel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
